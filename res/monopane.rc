#include <winres.h>
#include <commctrl.h>
#include "resource.h"

1 RT_MANIFEST "monopane.manifest"

IDI_APP ICON "monopane.ico"

IDD_SETTINGS DIALOGEX 0, 0, 252, 333
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Monopane settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Hotkeys", -1, 8, 8, 236, 105
    LTEXT           "Open the switcher", -1, 16, 23, 68, 8
    LTEXT           "", IDC_TXT_HOTKEY, 88, 22, 86, 12
    PUSHBUTTON      "Set...", IDC_BTN_HOTKEY, 182, 20, 54, 14
    LTEXT           "Rotate the display", -1, 16, 42, 68, 8
    LTEXT           "", IDC_TXT_ROTATE, 88, 41, 86, 12
    PUSHBUTTON      "Set...", IDC_BTN_ROTATE, 182, 39, 54, 14
    LTEXT           "Open the launchpad", -1, 16, 61, 68, 8
    LTEXT           "", IDC_TXT_LAUNCHPAD, 88, 60, 86, 12
    PUSHBUTTON      "Set...", IDC_BTN_LAUNCHPAD, 182, 58, 54, 14
    LTEXT           "", IDC_TXT_HOTKEY_HINT, 16, 79, 220, 28

    GROUPBOX        "Launchpad", -1, 8, 119, 236, 44
    LTEXT           "The pinned apps, their order and names live in launchpad.ini.",
                    -1, 16, 132, 220, 8
    PUSHBUTTON      "Open config folder", IDC_BTN_LAUNCHPAD_FOLDER, 16, 143, 90, 14

    GROUPBOX        "When activating a window", -1, 8, 169, 236, 46
    CONTROL         "Bring all windows of the same app forward", IDC_CHK_ACTIVATE_ALL,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 183, 220, 10
    LTEXT           "Off: only the selected window is activated.", -1, 27, 197, 209, 8

    GROUPBOX        "Switcher", -1, 8, 221, 236, 44
    CONTROL         "Preselect the previously active window", IDC_CHK_PRESELECT,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 235, 220, 10
    CONTROL         "Match app names when searching, not just titles", IDC_CHK_MATCH_APP,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 249, 220, 10

    GROUPBOX        "Search memory", -1, 8, 271, 236, 40
    LTEXT           "Monopane remembers which app you pick for each search.",
                    -1, 16, 283, 220, 8
    PUSHBUTTON      "Clear search memory", IDC_BTN_CLEAR_MEMORY, 16, 293, 90, 14

    CONTROL         "Start with Windows", IDC_CHK_AUTOSTART,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 317, 130, 10

    DEFPUSHBUTTON   "OK", IDOK, 140, 315, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 194, 315, 50, 14
END

IDD_PICKER DIALOGEX 0, 0, 300, 262
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add to the launchpad"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_PICK_SEARCH, 8, 8, 284, 14, ES_AUTOHSCROLL
    CONTROL         "", IDC_PICK_LIST, "SysListView32",
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOCOLUMNHEADER |
                    WS_BORDER | WS_TABSTOP, 8, 26, 284, 208
    DEFPUSHBUTTON   "Add", IDOK, 188, 240, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 242, 240, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Monopane"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "monopane"
            VALUE "OriginalFilename", "monopane.exe"
            VALUE "ProductName", "Monopane"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

#include <winres.h>
#include "resource.h"

1 RT_MANIFEST "mackeys.manifest"

IDI_APP ICON "mackeys.ico"

IDD_SETTINGS DIALOGEX 0, 0, 252, 186
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "MacKeys settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Remapping", -1, 8, 8, 236, 88
    CONTROL         "Caps Lock acts as Backspace", IDC_CHK_CAPS,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 22, 220, 10
    CONTROL         "Left cmd acts as Ctrl (Mac-style copy/paste)", IDC_CHK_LCMD,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 36, 220, 10
    CONTROL         "Right option is a nav-layer key (instead of Win key)", IDC_CHK_ROPT,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 50, 220, 10
    CONTROL         "Ctrl+Space opens the Start menu (like Spotlight)", IDC_CHK_CTRLSPACE,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 64, 220, 10
    CONTROL         "Left cmd+Space switches input language", IDC_CHK_CMDSPACE,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 78, 220, 10

    GROUPBOX        "Nav layer (hold right cmd)", -1, 8, 102, 236, 40
    LTEXT           "j k i l = arrows     h = Home     ; = End", -1, 16, 115, 220, 8
    LTEXT           "u / o = previous / next virtual desktop", -1, 16, 127, 220, 8

    CONTROL         "Start with Windows", IDC_CHK_AUTOSTART,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 148, 220, 10

    DEFPUSHBUTTON   "OK", IDOK, 140, 166, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 194, 166, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "MacKeys"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "mackeys"
            VALUE "OriginalFilename", "mackeys.exe"
            VALUE "ProductName", "MacKeys"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

{
    "global": {
        "show_in_menu_bar": false
    },
    "profiles": [
        {
            "name": "G915 mirror of MacKeys",
            "selected": true,
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Space chords, mirroring the Windows setup",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "spacebar",
                                    "modifiers": { "mandatory": ["left_option"] }
                                },
                                "to": [
                                    {
                                        "key_code": "spacebar",
                                        "modifiers": ["left_command"]
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "spacebar",
                                    "modifiers": { "mandatory": ["left_command"] }
                                },
                                "to": [
                                    {
                                        "key_code": "spacebar",
                                        "modifiers": ["left_control"]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "description": "Nav layer: hold right option",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "h",
                                    "modifiers": {
                                        "mandatory": ["right_option"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [{ "key_code": "home" }]
                            },
                            {
                                "type": "basic",

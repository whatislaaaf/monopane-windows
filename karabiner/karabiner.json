                                "type": "basic",
                                "from": {
                                    "key_code": "u",
                                    "modifiers": {
                                        "mandatory": ["right_option"],
                                        "optional": ["any"]
                                    }
                                },
                                "to": [
                                    {
                                        "key_code": "left_arrow",
                                        "modifiers": ["left_control"]
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "o",
                                    "modifiers": {
                                        "mandatory": ["right_option"],
                                        "optional": ["any"]
